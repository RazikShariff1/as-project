              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid parameter"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/user/{id}/session": {
      "delete": {
        "summary": "Sign a user out everywhere",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Exchange credentials for a session token (201). The same 401 for an unknown email and a wrong password; 403 for a suspended account (after the right password); 429 once locked.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          },
          "401": {
            "description": "No token, or unknown, expired or revoked, or bad credentials"
          },
          "403": {
            "description": "Suspended account, or not permitted"
          },
          "429": {
            "description": "Too many failed logins; account locked for 15 minutes"
          }
        }
      }
    },
    "/auth/google": {
      "post": {
        "summary": "Exchange a Google ID token for a session token (201), the same session as /auth/login. Google proves the caller owns a verified email; that email must belong to an existing, active user. An account is never created, and the password lockout does not apply.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Session"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "idToken missing"
          },
          "401": {
            "description": "The token is forged, expired, issued for another app, or its email is not verified"
          },
          "403": {
            "description": "No account is linked to this Google email, or the account is suspended"
          },
          "503": {
            "description": "Google sign-in is not enabled (GOOGLE_CLIENT_ID is not set)"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Who the bearer token belongs to",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Principal"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, or unknown, expired or revoked, or bad credentials"
          },
          "403": {
            "description": "Suspended account, or not permitted"
          }
        }
      }
    },
    "/auth/check": {
      "get": {
        "summary": "The gateway's per-request call: authenticate the bearer token and check the user may call method on path of service",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "method",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "The request path; a query string and trailing slash are ignored",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Principal"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          },
          "401": {
            "description": "No token, or unknown, expired or revoked, or bad credentials"
          },
          "403": {
            "description": "Suspended account, or not permitted"
          }
        }
      }
    },
    "/auth/session": {
      "delete": {
        "summary": "Log out: revoke the bearer token's session. Safe to repeat.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "401": {
            "description": "No token, or unknown, expired or revoked, or bad credentials"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "Create only; 8 to 72 characters. Ignored on update"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ],
            "default": "active"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "UserList": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "count": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "PasswordChangeRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "allAccess": {
            "type": "boolean"
          },
          "endpointIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RoleRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "allAccess": {
            "type": "boolean"
          },
          "endpointIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
