{
  "openapi": "3.0.3",
  "info": {
    "title": "account-svc",
    "version": "0.1.0",
    "description": "Generic accounts: users, roles, endpoint permissions and login with opaque session tokens. The gateway authorises every request through /auth/check; other services have no auth of their own."
  },
