APP_NAME=catalogue-svc
HTTP_PORT=8081
METRICS_PORT=2121
LOG_LEVEL=INFO

DB_DIALECT=postgres
DB_NAME=catalogue
DB_SSL_MODE=disable

# Seller product requests publish a change event; this service also subscribes to it and updates inventory-svc.
PUBSUB_BACKEND=GOOGLE
GOOGLE_SUBSCRIPTION_NAME=catalogue-subscriber
SELLER_PRODUCT_CHANGE_TOPIC=seller-product-change
INVENTORY_SERVICE_URL=http://localhost:8082
