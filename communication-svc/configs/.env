APP_NAME=communication-svc
HTTP_PORT=8086
METRICS_PORT=2127
LOG_LEVEL=INFO

DB_DIALECT=postgres
DB_NAME=communication
DB_SSL_MODE=disable

# Outgoing mail. Without SMTP_HOST nothing is delivered: emails are only logged (and marked sent), for local runs.
# 587 uses STARTTLS, 465 implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# A failed delivery is retried with a growing delay (30s, 60s, 120s...) until it has been tried this many times.
EMAIL_MAX_ATTEMPTS=5
