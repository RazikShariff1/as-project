APP_NAME=communication-svc
HTTP_PORT=8086
METRICS_PORT=2127
LOG_LEVEL=INFO

DB_DIALECT=postgres
DB_NAME=communication
DB_SSL_MODE=disable

# Outgoing mail; the first of these that is configured is used, and with none emails are only logged (and marked sent).
# 1. Gmail API over HTTPS: works on Render's free plan, which blocks SMTP ports. Mail goes out as the Gmail account itself.
#    The refresh token needs the gmail.send scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
# 2. SMTP (587 STARTTLS, 465 implicit TLS). Blocked on Render's free plan.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# The display name on the From line, for either.
MAIL_FROM_NAME=

# A failed delivery is retried with a growing delay (30s, 60s, 120s...) until it has been tried this many times.
EMAIL_MAX_ATTEMPTS=5
