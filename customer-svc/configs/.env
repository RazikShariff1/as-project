APP_NAME=customer-svc
HTTP_PORT=8085
METRICS_PORT=2126
LOG_LEVEL=INFO

DB_DIALECT=postgres
DB_NAME=customer
DB_SSL_MODE=disable

# Login sessions (default 7 days)
SESSION_TTL_MINUTES=10080

# Emails (the welcome after registering) go through communication-svc; leave empty to send none.
COMMUNICATION_SERVICE_URL=http://localhost:8086
