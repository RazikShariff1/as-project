APP_NAME=gateway-svc
HTTP_PORT=8080
METRICS_PORT=2124
LOG_LEVEL=INFO

# Where each backend lives. Local defaults: the services run on these ports.
ACCOUNT_SVC_URL=http://localhost:8083
CATALOGUE_SVC_URL=http://localhost:8081
INVENTORY_SVC_URL=http://localhost:8082
ORDER_SVC_URL=http://localhost:8084
CUSTOMER_SVC_URL=http://localhost:8085

# Seconds a proxied request may take, and the largest request body the gateway will read (bytes).
PROXY_TIMEOUT_SECONDS=30
MAX_BODY_BYTES=1048576

# Per-IP limit on login attempts per minute (the account service also locks an account after repeated failures).
LOGIN_RATE_PER_MINUTE=10
# Only true when the gateway sits behind a trusted proxy that sets X-Forwarded-For.
TRUST_FORWARDED_FOR=false
