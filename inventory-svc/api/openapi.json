{
  "openapi": "3.0.3",
  "info": {
    "title": "inventory-svc",
    "version": "0.3.0",
    "description": "Per-seller offers for shared catalogue products: stock and price per (variant, seller), their audit logs and order reservations. IDs are integers. All quantities are in base units. No service-level auth: the gateway authenticates requests and must restrict a seller to their own {sellerId}."
  },
  "paths": {
    "/stock": {
      "get": {
        "summary": "List offers",
        "parameters": [
          {
            "name": "variantId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "sellerId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ENABLED",
                "HIDDEN"
              ]
            }
          },
          {
            "name": "lowStock",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "outOfStock",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/StockList"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          }
        }
      }
    },
    "/stock/availability": {
      "get": {
        "summary": "Storefront view of up to 100 variants: every visible seller's offer (never cost price), cheapest first, and the default bestOffer (lowest selling price among sellers with stock; ties go to the house seller)",
        "parameters": [
          {
            "name": "variantIds",
            "in": "query",
            "required": true,
            "description": "Comma-separated variant ids",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/VariantAvailability"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          }
        }
      }
    },
    "/stock/{id}/seller/{sellerId}": {
      "get": {
        "summary": "One seller's offer for a variant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Catalogue variant id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Stock"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "put": {
        "summary": "Set that seller's absolute quantity (creates the row on first use)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Catalogue variant id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Stock"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          }
        }
      },
      "delete": {
        "summary": "Withdraw the offer: it is hidden, and its stock, history and reservations are kept",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Catalogue variant id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Withdrawn"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/stock/{id}/seller/{sellerId}/offer": {
      "put": {
        "summary": "Create the offer with zero stock, or update only its mrp and discount and make it visible. Never touches quantity, so repeating it is safe. Called when a seller product request is approved.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Catalogue variant id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Stock"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          }
        }
      }
    },
    "/stock/{id}/seller/{sellerId}/adjust": {
      "put": {
        "summary": "Add or remove stock by a delta. A repeated referenceType+referenceId for the same offer is rejected with 409.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Catalogue variant id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdjustRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Stock"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict, e.g. insufficient stock for a seller's offer or a clashing reservation"
          }
        }
      }
    },
    "/stock/{id}/seller/{sellerId}/price": {
      "put": {
        "summary": "Replace mrp, discount, cost price, tax and HSN code. Logs each changed field. 404 if the seller has no row for the variant.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Catalogue variant id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Stock"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Negative amount, discount above mrp, or a discount without an mrp"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/stock/{id}/seller/{sellerId}/movement": {
      "get": {
        "summary": "The offer's quantity audit log, newest first",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Catalogue variant id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MovementList"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          }
        }
      }
    },
    "/stock/{id}/seller/{sellerId}/price-log": {
      "get": {
        "summary": "The offer's price-change history, newest first",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Catalogue variant id",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PriceChangeList"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          }
        }
      }
    },
    "/reservation": {
      "post": {
        "summary": "Hold stock for an order, all offers or none. Each line names the seller it buys from. Repeating the same request returns the existing reservation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Reservation"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter"
          },
          "409": {
            "description": "Conflict, e.g. insufficient stock for a seller's offer or a clashing reservation"
          }
        }
      }
    },
    "/reservation/release-expired": {
      "put": {
        "summary": "Release holds past their expiry; call from a scheduler",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Released"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reservation/{orderRef}": {
      "get": {
        "summary": "Get a reservation",
        "parameters": [
          {
            "name": "orderRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Reservation"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/reservation/{orderRef}/confirm": {
      "put": {
        "summary": "The order was paid: stock leaves for good. Safe to repeat.",
        "parameters": [
          {
            "name": "orderRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Reservation"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict, e.g. insufficient stock for a seller's offer or a clashing reservation"
          }
        }
      }
    },
    "/reservation/{orderRef}/release": {
      "put": {
        "summary": "The order was abandoned: stock becomes available. Safe to repeat; a confirmed reservation cannot be released.",
        "parameters": [
          {
            "name": "orderRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Reservation"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict, e.g. insufficient stock for a seller's offer or a clashing reservation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Stock": {
        "type": "object",
        "properties": {
          "variantId": {
            "type": "integer",
            "format": "int64"
          },
          "sellerId": {
            "type": "integer",
            "format": "int64"
          },
          "quantity": {
            "type": "integer",
            "format": "int64"
          },
          "reserved": {
            "type": "integer",
            "format": "int64"
          },
          "available": {
            "type": "integer",
            "format": "int64"
          },
          "inStock": {
            "type": "boolean"
          },
          "unlimitedStock": {
            "type": "boolean"
          },
          "unit": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "HIDDEN"
            ]
          },
          "lowStockThreshold": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "mrp": {
            "type": "number",
            "nullable": true
          },
          "discount": {
            "type": "number"
          },
          "costPrice": {
            "type": "number",
            "nullable": true,
            "description": "Internal; never on the storefront availability call"
          },
          "sellingPrice": {
            "type": "number",
            "nullable": true,
            "description": "mrp - discount"
          },
          "tax": {
            "type": "string"
          },
          "hsnCode": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StockRequest": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "format": "int64"
          },
          "unit": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ENABLED",
              "HIDDEN"
            ],
            "default": "ENABLED"
          },
          "unlimitedStock": {
            "type": "boolean"
          },
          "lowStockThreshold": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "notes": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "StockList": {
        "type": "object",
        "properties": {
          "stock": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stock"
            }
          },
          "count": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "OfferRequest": {
        "type": "object",
        "description": "Creates the offer with zero stock or updates only mrp and discount, and makes it visible. Never touches quantity.",
        "properties": {
          "mrp": {
            "type": "number"
          },
          "discount": {
            "type": "number",
            "description": "An amount off mrp, 0 to mrp"
          },
          "notes": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "PriceRequest": {
        "type": "object",
        "description": "Replaces all five fields. discount is an amount off mrp, needs an mrp and cannot exceed it.",
        "properties": {
          "mrp": {
            "type": "number",
            "nullable": true
          },
          "discount": {
            "type": "number"
          },
          "costPrice": {
            "type": "number",
            "nullable": true
          },
          "tax": {
            "type": "string"
          },
          "hsnCode": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "AdjustRequest": {
        "type": "object",
        "properties": {
          "delta": {
            "type": "integer",
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "RETURNED_TO_SELLER",
              "EXPIRED",
              "DAMAGED",
              "RETURNED",
              "SOLD",
              "RECOUNTED",
              "OTHER"
            ],
            "description": "Defaults to OTHER"
          },
          "notes": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "referenceType": {
            "type": "string"
          },
          "referenceId": {
            "type": "string"
          }
        }
      },
      "Offer": {
        "type": "object",
        "properties": {
          "sellerId": {
            "type": "integer",
            "format": "int64"
          },
          "available": {
            "type": "integer",
            "format": "int64"
          },
          "inStock": {
            "type": "boolean"
          },
          "unlimitedStock": {
            "type": "boolean"
          },
          "unit": {
            "type": "integer"
          },
          "mrp": {
            "type": "number",
            "nullable": true
          },
          "discount": {
            "type": "number"
          },
          "sellingPrice": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "VariantAvailability": {
        "type": "object",
        "properties": {
          "variantId": {
            "type": "integer",
            "format": "int64"
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Offer"
            }
          },
          "bestOffer": {
            "$ref": "#/components/schemas/Offer",
            "nullable": true
          }
        }
      },
      "Movement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "variantId": {
            "type": "integer",
            "format": "int64"
          },
          "sellerId": {
            "type": "integer",
            "format": "int64"
          },
          "delta": {
            "type": "integer",
            "format": "int64"
          },
          "quantityAfter": {
            "type": "integer",
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "RETURNED_TO_SELLER",
              "EXPIRED",
              "DAMAGED",
              "RETURNED",
              "SOLD",
              "RECOUNTED",
              "OTHER"
            ]
