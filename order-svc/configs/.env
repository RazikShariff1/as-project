APP_NAME=order-svc
HTTP_PORT=8084
METRICS_PORT=2125
LOG_LEVEL=INFO

DB_DIALECT=postgres
DB_NAME=orders
DB_SSL_MODE=disable

# Where inventory-svc is: orders read prices from it and reserve, confirm and release stock through it.
INVENTORY_SERVICE_URL=http://localhost:8082
# How long a new order holds its stock before inventory-svc may release it (seconds; at most 86400).
RESERVATION_TTL_SECONDS=86400
