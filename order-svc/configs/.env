APP_NAME=order-svc
HTTP_PORT=8084
METRICS_PORT=2125
LOG_LEVEL=INFO

DB_DIALECT=postgres
DB_NAME=orders
DB_SSL_MODE=disable

# Where inventory-svc is: orders read prices from it and reserve, confirm and release stock through it.
INVENTORY_SERVICE_URL=http://localhost:8082
# How long a new order holds its stock before inventory-svc may release it (seconds; at most 86400).
RESERVATION_TTL_SECONDS=86400

# A new order is confirmed to the shopper and announced to ADMIN_EMAIL by email, through communication-svc; leave the URL empty to
# send none. The shopper's address comes from customer-svc and product names from catalogue-svc (best effort).
COMMUNICATION_SERVICE_URL=http://localhost:8086
CUSTOMER_SERVICE_URL=http://localhost:8085
CATALOGUE_SERVICE_URL=http://localhost:8081
# Shown in the emails: the store's name (subject and greeting), an optional support address, and the amounts' currency symbol.
STORE_NAME=Zopping
SUPPORT_EMAIL=
CURRENCY_SYMBOL=₹
